# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realdealtracker

# Supabase Auth (required for production, dummy values used in development)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Client (required for production, dummy values used in development)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (required for production, dummy values used in development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
# Tier granted by an active subscription (must match a TIER_LIMITS key:
# free | basic | pro | enterprise). Defaults to "pro".
STRIPE_PAID_TIER=pro

# OpenAI (required for AI commentary, underwriting, and offer generation)
OPENAI_API_KEY=sk-...

# RapidAPI (required for Zillow, LoopNet, and Redfin property search)
RAPIDAPI_KEY=your-rapidapi-key

# Optional: third-party data enrichment
WALKSCORE_API_KEY=your-walkscore-key
CRIMEOMETER_API_KEY=your-crimeometer-key

# Server (optional, defaults shown)
PORT=5000
NODE_ENV=development
